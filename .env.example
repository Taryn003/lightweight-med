MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
APP_AUTH_USER=doctor
APP_AUTH_PASS=123456

# GPU 放置（默认整块模型在首张可见 GPU 上，避免 device_map=auto 把部分层卸到 CPU 变慢）
# VLM_FORCE_CUDA=true
# VLM_CUDA_DEVICE=0
# 需要 accelerate 自动切分时改为：VLM_DEVICE_MAP=auto

# GPU INT8（bitsandbytes，需 CUDA）：对比实验时可临时开启，默认关闭
# VLM_LOAD_IN_8BIT=true

# 推理加速（可选）：缩短生成长度、关闭采样通常更快，质量略降
# INFERENCE_MAX_NEW_TOKENS=256
# INFERENCE_DO_SAMPLE=false

# 相同输入希望输出尽量一致：等价于关闭采样（贪心解码）
# INFERENCE_DETERMINISTIC=true
# INFERENCE_SEED=42
